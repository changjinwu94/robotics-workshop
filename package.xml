<?xml version="1.0"?>
<package format="3">
  <name>robot_lab</name>
  <version>1.0.0</version>
  <description>UDP operator bridge and launch file for a headless turtlesim workshop.</description>
  <maintainer email="workshop@example.invalid">Workshop instructors</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>turtlesim</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
